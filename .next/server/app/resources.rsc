a:["$","p",null,{"className":"text-muted-foreground font-sans text-lg mb-12","children":"Welcome to the official documentation for RymeHelper, the ultimate songwriting text editor and rhyming dictionary. This document provides a comprehensive overview of the application's architecture, features, and usage."}]
b:["$","div",null,{"className":"prose prose-invert max-w-none font-sans text-muted-foreground space-y-6","children":[["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Introduction"}],["$","p",null,{"children":"RymeHelper is a dedicated desktop application built with React, Vite, and Electron, designed specifically for songwriters, poets, and vocalists. It bridges the gap between a distraction-free writing environment and a powerful linguistic analysis tool, allowing creators to find perfect rhymes, count syllables, and manage multiple projects simultaneously without ever breaking their creative flow."}],["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Core Editor Features"}],["$","p",null,{"children":"At the heart of RymeHelper is a robust, rich-text editor powered by Tiptap/ProseMirror. It includes standard formatting tools as well as custom extensions tailored for songwriting."}],["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Rich Text Formatting:"}]," Standard support for bold, italic, underline, strikethrough, highlighting, and text alignment."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Syllable Counter:"}]," Automatically calculates and displays syllable counts for lines, helping you maintain consistent rhythm and meter."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Auto-Rhyme Highlighter:"}]," Intelligently highlights words at the end of lines that rhyme, giving you a visual representation of your rhyme scheme."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Line Manipulation:"}]," Dedicated tools for shifting, rearranging, and formatting stanzas and verses efficiently."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Auto-Scroll:"}]," A built-in teleprompter feature that smoothly scrolls your lyrics during recording or practice sessions. The speed can be adjusted via the footer interface."]}]]}],["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Rhyming & Dictionary Tools"}],["$","p",null,{"children":"RymeHelper integrates seamlessly with linguistic databases (via the Datamuse API) to provide instant lyrical inspiration directly within the editor."}],["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Instant Word Selection:"}]," Highlight any word in the editor to open the contextual Rhyme Popup."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Exact Rhymes:"}]," Find words that perfectly rhyme with your selection."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Near Rhymes (Slant Rhymes):"}]," Discover words with similar vowel or consonant sounds to expand your creative options when exact rhymes feel too restrictive."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Multisyllabic Rhyming (Pro Feature):"}]," Search for complex, multi-word phrases that rhyme with entire bars or stanzas."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Synonyms & Sounds Like:"}]," Broaden your vocabulary by finding synonyms or words that have a phonetic resemblance to your target word."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Side Panel Dictionary:"}]," A dedicated, persistent side panel that allows you to search the dictionary without losing your place in the editor."]}]]}],["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Project Management"}],["$","p",null,{"children":"Managing multiple songs, verses, and ideas is streamlined through the Project Sidebar and Tab System."}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c"]}]
c:["$","div",null,{"className":"mt-16 bg-primary/10 border border-primary/20 p-8 rounded-xl text-center","children":[["$","h2",null,{"className":"text-2xl font-display uppercase tracking-wide mb-4","children":"Need More Help?"}],["$","p",null,{"className":"text-muted-foreground font-sans mb-6 max-w-lg mx-auto","children":"Can't find what you're looking for? Our support team is here to help you get the most out of RymeHelper."}],["$","a",null,{"href":"mailto:support@rhymehelper.store","className":"inline-block px-6 py-3 bg-primary text-white font-mono rounded-md hover:bg-primary/90 transition-colors","children":"Contact Support"}]]}]
