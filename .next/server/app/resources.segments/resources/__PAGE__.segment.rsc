4:["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Instant Word Selection:"}]," Highlight any word in the editor to open the contextual Rhyme Popup."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Exact Rhymes:"}]," Find words that perfectly rhyme with your selection."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Near Rhymes (Slant Rhymes):"}]," Discover words with similar vowel or consonant sounds to expand your creative options when exact rhymes feel too restrictive."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Multisyllabic Rhyming (Pro Feature):"}]," Search for complex, multi-word phrases that rhyme with entire bars or stanzas."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Synonyms & Sounds Like:"}]," Broaden your vocabulary by finding synonyms or words that have a phonetic resemblance to your target word."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Side Panel Dictionary:"}]," A dedicated, persistent side panel that allows you to search the dictionary without losing your place in the editor."]}]]}]
5:["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Project Management"}]
6:["$","p",null,{"children":"Managing multiple songs, verses, and ideas is streamlined through the Project Sidebar and Tab System."}]
7:["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Local File System Integration:"}]," Projects can be saved directly to your hard drive (e.g., .txt or .md files) using modern File System Access APIs."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Auto-Save:"}]," Any changes made in the editor are automatically debounced and saved locally to prevent data loss."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Tabbed Interface:"}]," Open multiple songs at once using the top tab bar."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Split-Screen View:"}]," Compare two songs, verses, or reference tracks side-by-side. You can easily drag and drop tabs between the left and right panels."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Project Sidebar:"}]," A centralized hub to create new songs, switch between recent projects, or permanently delete old drafts."]}]]}]
8:["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Workspace Modes"}]
9:["$","p",null,{"children":"RymeHelper adapts to the different phases of the songwriting process through specialized workspace modes."}]
a:["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Focus Mode:"}]," Activated via F11 or the menu bar. This mode strips away all sidebars, menus, and distractions, leaving only the text editor and a dark background for deep, uninterrupted writing."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Studio Mode:"}]," Designed for the recording booth. It exposes the built-in Audio Player, allowing you to load beats or reference tracks and play them directly within the app while writing or recording."]}]]}]
b:["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Account & Licensing"}]
c:["$","p",null,{"children":"RymeHelper offers both a robust free version and a premium \"Pro\" tier for serious artists."}]
d:["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Authentication:"}]," Secure user accounts managed via Supabase. Users can sign up and log in via email."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Password Recovery:"}]," Built-in password reset flows accessible directly from the login screen."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Pro Features (Studio Pass):"}]," Advanced features, such as Multisyllabic Rhyme searching, are unlocked via a license key. License keys are securely validated and managed through LemonSqueezy integration."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Offline Capabilities:"}]," The app requires an internet connection for dictionary queries and initial login, but the core writing and file-saving functionalities are fully supported offline."]}]]}]
e:["$","h2",null,{"className":"text-2xl font-display uppercase text-foreground mt-8 mb-4","children":"Security & Resilience"}]
f:["$","p",null,{"children":"RymeHelper is built with modern desktop security practices to ensure your data and system remain safe."}]
10:["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Context Isolation:"}]," The Electron wrapper uses strict context isolation and disables Node integration in the renderer process to prevent malicious code execution."]}],["$","li",null,{"children":[["$","strong",null,{"children":"XSS Protection:"}]," All loaded project content is heavily sanitized using DOMPurify before rendering."]}],["$","li",null,{"children":[["$","strong",null,{"children":"API Rate Limiting:"}]," Built-in LRU (Least Recently Used) memory caching prevents duplicate queries to external dictionary APIs, ensuring fast responses and preventing rate limits."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Graceful Error Handling:"}]," Comprehensive React Error Boundaries and file-system fallbacks ensure that unexpected errors do not crash the application or result in lost lyrics."]}]]}]
